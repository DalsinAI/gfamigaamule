@@ -50,6 +50,27 @@ enum {
 	TRAY_ICON_HIGHID
 };
 
+#ifdef __AMIGA__
+// AmigaOS has no system tray: the preference is off and this class does
+// nothing, so the main window's calls stay as they are.
+class CMuleTrayIcon
+{
+public:
+	CMuleTrayIcon() {}
+	~CMuleTrayIcon() {}
+	void SetTrayIcon(int, uint32) {}
+	void SetTrayToolTip(const wxString&) {}
+	void DoConnectDisconnect() {}
+	void DoShowHide() {}
+	void DoShow() {}
+	void DoHide() {}
+	void DoExit() {}
+	void DoSetUploadLimit(long) {}
+	void DoSetDownloadLimit(long) {}
+	void RebuildMenu() {}
+};
+#else // !__AMIGA__
+
 // Backend selection:
 //
 // Linux with libayatana-appindicator3 → SNI (StatusNotifierItem)
@@ -156,6 +177,8 @@ private:
 #endif
 };
 
+#endif // __AMIGA__
+
 #endif // DAEMON
 
 #endif //MULETRAYICON_H
