@@ -1570,6 +1574,31 @@ void CLibUDPSocket::Destroy()
  * CAsioService - ASIO event loop thread
  */
 
+#ifdef __AMIGA__
+#include <wx/timer.h>
+// AmigaOS: bsdsocket.library is opened per task and a socket belongs to the
+// task that made it, so Asio can't run in threads of its own. The main task
+// runs it instead: a timer polls the io_context between GUI events.
+class CAsioServiceThread : public wxTimer {
+public:
+	CAsioServiceThread()
+	{
+		Start(10);
+	}
+
+	void Notify()
+	{
+		if (!s_io_service.stopped()) {
+			s_io_service.poll();
+		}
+	}
+
+	void Wait()
+	{
+		wxTimer::Stop();
+	}
+};
+#else
 class CAsioServiceThread : public wxThread {
 public:
 	CAsioServiceThread() : wxThread(wxTHREAD_JOINABLE)
@@ -1593,6 +1622,7 @@ public:
 private:
 	int m_threadNumber;
 };
+#endif
 
