# Lab diagnostic, not for merge: startup stages, scheduler tasks and the IP
# filter loader go to SYS:T/amule.trace when ENV:aMule.trace is set ("t":
# from threads only).
diff --git a/src/ThreadScheduler.cpp b/src/ThreadScheduler.cpp
index bb8662c..482a303 100644
--- a/src/ThreadScheduler.cpp
+++ b/src/ThreadScheduler.cpp
@@ -27,6 +27,12 @@
 #include <common/Format.h>		// Needed for CFormat
 #include "ScopedPtr.h"			// Needed for CScopedPtr
 
+#ifdef __AMIGA__
+extern "C" void amigaamule_trace(const char *, ...);
+#define AMTRACE(...) amigaamule_trace(__VA_ARGS__)
+#else
+#define AMTRACE(...)
+#endif
 #include <algorithm>			// Needed for std::sort		// Do_not_auto_remove (mingw-gcc-3.4.5)
 
 //! Global lock the scheduler and its thread.
@@ -154,9 +160,11 @@ void CThreadScheduler::CreateSchedulerThread()
 	wxThreadError err = m_thread->Create();
 	if (err == wxTHREAD_NO_ERROR) {
 		// Try to avoid reducing the latency of the main thread
+		AMTRACE("sched thread created");
 		m_thread->SetPriority(WXTHREAD_MIN_PRIORITY);
 
 		err = m_thread->Run();
+		AMTRACE("sched thread run %d", (int)err);
 		if (err == wxTHREAD_NO_ERROR) {
 			AddDebugLogLineN(logThreads, "Scheduler thread started");
 			return;
@@ -288,8 +296,11 @@ void* CThreadScheduler::Entry()
 		AddDebugLogLineN(logThreads, "Current task: " + task->GetType() + " - " + task->GetDesc());
 		// Execute the task
 		task->m_owner = m_thread;
+		AMTRACE("task %s", (const char*)task->GetType().utf8_str());
 		task->Entry();
+		AMTRACE("task entry done");
 		task->OnExit();
+		AMTRACE("task exit done");
 
 		// Check if this was the last task of this type
 		bool isLastTask = false;
@@ -323,10 +334,12 @@ void* CThreadScheduler::Entry()
 			// Allow the task to signal that all sub-tasks have been completed
 			AddDebugLogLineN(logThreads, "Last task, calling OnLastTask");
 			task->OnLastTask();
+			AMTRACE("last task done");
 		}
 	}
 
 	AddDebugLogLineN(logThreads, "Leaving scheduling loop");
+	AMTRACE("leaving loop");
 
 	return 0;
 }
