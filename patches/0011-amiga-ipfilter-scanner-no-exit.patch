# AmigaOS: a flex error in the IP filter loader (on a thread) reports errno
# on stderr and stops that thread, instead of exit() from the thread.
diff --git a/src/IPFilterScanner.l b/src/IPFilterScanner.l
index 84d7896..3927548 100644
--- a/src/IPFilterScanner.l
+++ b/src/IPFilterScanner.l
@@ -51,6 +51,24 @@
 
 #define YY_NEVER_INTERACTIVE 1
 
+#ifdef __AMIGA__
+// A flex error must not exit(): this runs on a thread, and exit() from a
+// thread takes the whole program down. Say what failed, with errno, on
+// stderr, and stop this thread's work.
+#include <errno.h>
+#include <unistd.h>
+#include <clib/exec_protos.h>
+static void amiga_flex_fatal(const char *msg)
+{
+	fprintf(stderr, "IPFilterScanner: %s (errno %d, ferror %d, feof %d, isatty %d)\n",
+		msg, errno, yyin ? ferror(yyin) : -1, yyin ? feof(yyin) : -1,
+		yyin ? isatty(fileno(yyin)) : -1);
+	fflush(stderr);
+	Wait(0);	// never returns: the thread stays, the program goes on
+}
+#define YY_FATAL_ERROR(msg) amiga_flex_fatal(msg)
+#endif
+
 // When we get here the IP has been lexed nicely,
 // so we can blaze through without any checks.
 // The total lexing time is more than twice as fast
