; $VER: Install-aMule 3.0.0-amiga.2 (10.11.2026)
; The Amiga Installer script for aMule, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the aMule drawer where the archive was unpacked.

(set @app-name "aMule")
(set #version "3.0.0-amiga.2")
(set #drawer "aMule")
(set #program "aMule")
(set #space 19532)  ; KB

(onerror
    (message (cat "aMule was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-aMule again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "aMule needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "aMule needs a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The aMule drawer is not beside Install-aMule. Unpack the whole archive, then run Install-aMule from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The aMule drawer has no aMule in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/event.library") (noreq)) 1)
    (abort "The aMule drawer has no Libs/event.library in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/regex.library") (noreq)) 1)
    (abort "The aMule drawer has no Libs/regex.library in it. Unpack the whole archive again."))

(welcome "This installs aMule 3.0.0-amiga.2 for AmigaOS 3.2 on a 68040, 68060 or 68080.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:" (noreq)) 2) "Work:"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the aMule drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called aMule in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": aMule needs 20 MB free.")))

; shared libraries: into LIBS:, where the one there is older or missing
(copylib
    (prompt "Copying event.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/event.library"))
    (dest "LIBS:"))
(copylib
    (prompt "Copying regex.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/regex.library"))
    (dest "LIBS:"))
(complete 40)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying aMule")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating aMule. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "aMule.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "aMule.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. aMule would have gone in " #dest "."))
    (message (cat "aMule 3.0.0-amiga.2 is installed in " #dest "."
                  "\n\nTo start it, open the aMule drawer and double-click the aMule icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
